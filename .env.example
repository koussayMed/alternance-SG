# Copy to .env (ignored by git) and change the passwords. Never commit .env.
POSTGRES_DB=meteo
POSTGRES_USER=meteo
# Letters and digits only (inserted as is in the backend connection URL)
POSTGRES_PASSWORD=change-me

# Database port on your machine; 55432 avoids a local Postgres or a Windows reserved port range
DB_HOST_PORT=55432

LOG_LEVEL=INFO
WEATHER_CACHE_TTL_S=600

# Local Grafana admin (http://localhost:3000); dashboards are read-only without login
GRAFANA_ADMIN_PASSWORD=change-me-too
